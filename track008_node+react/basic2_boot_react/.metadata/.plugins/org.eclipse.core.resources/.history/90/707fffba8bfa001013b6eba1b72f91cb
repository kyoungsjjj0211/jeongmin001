package com.thejoa703.service;

import java.io.File;
import java.io.IOException;
import java.util.UUID;

import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import com.thejoa703.dto.request.MaterialSaveRequestDto;
import com.thejoa703.entity.Material;
import com.thejoa703.repository.MaterialRepository;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class MaterialService {
    
    private final MaterialRepository repository;

    // 1. 재료 저장 로직
    public void saveMaterial(MaterialSaveRequestDto dto, MultipartFile file) {
        // 파일 업로드 처리 (아래 정의된 메서드 호출)
        String fileName = handleFileUpload(file);
        
        // DTO -> Entity 변환 (Builder 패턴)
        Material material = Material.builder()
                .title(dto.getTitle())
                .imageurl(fileName)
                .allergy(dto.getAllergy())
                .season(dto.getSeason())
                .temperature(dto.getTemperature())
                .calories100g(dto.getCalories100g())
                .efficacy(dto.getEfficacy())
                .buyguide(dto.getBuyguide())
                .trimguide(dto.getTrimguide())
                .storeguide(dto.getStoreguide())
                .category(dto.getCategory())
                .build();
        
        repository.save(material); // JPA Repository의 기본 메서드 사용
    }

    // 2. 파일 업로드 실무 로직 (이 부분이 없어서 에러가 났던 거예요!)
    private String handleFileUpload(MultipartFile file) {
        String uploadPath = "C:/upload/"; // 파일 저장 경로
        File folder = new File(uploadPath);
        
        // 폴더가 없으면 생성
        if (!folder.exists()) {
            folder.mkdirs();
        }

        // 파일이 없으면 기본 이미지 반환
        if (file == null || file.isEmpty()) {
            return "default.png";
        }

        String originalFileName = file.getOriginalFilename();
        // 파일명 중복 방지를 위해 UUID 생성
        String savedFileName = UUID.randomUUID().toString() + "_" + originalFileName;

        try {
            file.transferTo(new File(uploadPath + savedFileName));
            return savedFileName;
        } catch (IOException e) {
            e.printStackTrace();
            return "default.png"; // 실패 시 기본 이미지
        }
    }
}