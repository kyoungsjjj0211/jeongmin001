package com.thejoa703.controller;

import java.util.List;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;
import org.springframework.web.servlet.mvc.support.RedirectAttributes;

import com.thejoa703.dto.MaterialDto;
import com.thejoa703.service.MaterialService; // 통합된 서비스 임포트

@Controller
@RequestMapping("/material")
public class MaterialController {

    @Autowired
    private MaterialService service; // 통합 클래스를 직접 주입받음

    // 1. 재료 목록 조회 (페이징 및 검색 포함)
    @GetMapping("/list")
    public String list(@RequestParam(value = "pstartno", defaultValue = "1") int pstartno,
                       @RequestParam(value = "keyword", defaultValue = "") String keyword,
                       Model model) {
        
        List<MaterialDto> list = service.select10(pstartno, keyword);
        int totalCnt = service.selectTotalCnt(keyword);
        
        model.addAttribute("list", list);
        model.addAttribute("totalCnt", totalCnt);
        model.addAttribute("keyword", keyword);
        
        return "material/list"; // JSP 또는 Thymeleaf 경로
    }

    // 2. 재료 등록 폼 이동
    @GetMapping("/insert")
    public String insertForm() {
        return "material/insert";
    }

    // 3. 재료 등록 처리 (파일 업로드 포함)
    @PostMapping("/insert")
    public String insert(@RequestParam("file") MultipartFile file, 
                         MaterialDto dto, 
                         RedirectAttributes rttr) {
        
        // 파일이 포함된 insert2Material 메서드 호출
        int result = service.insert2Material(file, dto);
        
        if (result > 0) {
            rttr.addFlashAttribute("msg", "success");
        } else {
            rttr.addFlashAttribute("msg", "fail");
        }
        return "redirect:/material/list";
    }

    // 4. 재료 수정 처리
    @PostMapping("/update")
    public String update(@RequestParam("file") MultipartFile file, 
                         MaterialDto dto, 
                         RedirectAttributes rttr) {
        
        int result = service.update2Material(file, dto);
        
        if (result > 0) {
            rttr.addFlashAttribute("msg", "update_success");
        }
        return "redirect:/material/list";
    }

    // 5. 재료 삭제 처리
    @GetMapping("/delete")
    public String delete(@RequestParam("materialid") int materialid) {
        service.deleteMaterial(materialid);
        return "redirect:/material/list";
    }
}