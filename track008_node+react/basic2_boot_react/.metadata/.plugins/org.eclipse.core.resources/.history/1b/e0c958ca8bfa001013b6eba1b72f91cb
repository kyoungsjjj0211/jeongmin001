package com.thejoa703.service;

import java.io.File;
import java.io.IOException;
import java.util.List;
import java.util.UUID;
import java.util.stream.Collectors;

import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.data.domain.Sort;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import com.thejoa703.dto.request.MaterialSaveRequestDto;

import com.thejoa703.entity.Material;
import com.thejoa703.repository.MaterialRepository;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class MaterialService {
    
    private final MaterialRepository repository;

    // [추가] 목록 조회 메서드
    public List<MaterialResponseDto> getMaterialList(int page, String keyword) {
        // JPA는 페이지가 0부터 시작하므로 page - 1
        Pageable pageable = PageRequest.of(page - 1, 10, Sort.by("materialid").descending());
        
        return repository.findByTitleContaining(keyword, pageable)
                .stream()
                .map(MaterialResponseDto::new)
                .collect(Collectors.toList());
    }

    // [추가] 전체 개수 조회 메서드
    public long getTotalCount(String keyword) {
        return repository.countByTitleContaining(keyword);
    }

    public void saveMaterial(MaterialSaveRequestDto dto, MultipartFile file) {
        String fileName = handleFileUpload(file);
        
        Material material = Material.builder()
                .title(dto.getTitle())
                .imageurl(fileName)
                .category(dto.getCategory())
                .allergy(dto.getAllergy())
                .season(dto.getSeason())
                .temperature(dto.getTemperature())
                .calories100g(dto.getCalories100g())
                .efficacy(dto.getEfficacy())
                .buyguide(dto.getBuyguide())
                .trimguide(dto.getTrimguide())
                .storeguide(dto.getStoreguide())
                .build();
        
        repository.save(material);
    }

    private String handleFileUpload(MultipartFile file) {
        String uploadPath = "C:/upload/";
        if (file == null || file.isEmpty()) return "default.png";

        String savedFileName = UUID.randomUUID().toString() + "_" + file.getOriginalFilename();
        try {
            File folder = new File(uploadPath);
            if (!folder.exists()) folder.mkdirs();
            file.transferTo(new File(uploadPath + savedFileName));
            return savedFileName;
        } catch (IOException e) {
            return "default.png";
        }
    }
}