package com.thejoa703;

import com.thejoa703.dto.request.MaterialSaveRequestDto;
import com.thejoa703.dto.response.MaterialResponseDto;
import com.thejoa703.entity.Material;
import com.thejoa703.repository.MaterialRepository;
import com.thejoa703.service.MaterialService;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;

import static org.assertj.core.api.Assertions.assertThat;

@SpringBootTest
@Transactional // 테스트 완료 후 DB 데이터를 롤백하여 깨끗하게 유지합니다.
class MaterialServiceTest {

    @Autowired
    private MaterialService materialService;

    @Autowired
    private MaterialRepository materialRepository;

    @Test
    @DisplayName("재료 CRUD 통합 테스트")
    void materialFullCycleTest() {
        // [1] 저장 테스트 (Save)
        MaterialSaveRequestDto saveRequest = new MaterialSaveRequestDto();
        saveRequest.setTitle("테스트용 양파");
        saveRequest.setCategory("채소");
        saveRequest.setSeason("봄, 가을");
        saveRequest.setEfficacy("항산화 작용");
        
        // 파일은 null로 보냅니다 (Service에서 default.png로 처리됨)
        int saveResult = materialService.saveMaterial(saveRequest, null);
        assertThat(saveResult).isEqualTo(1);

        // [2] 목록 조회 테스트 (List/Search)
        List<MaterialResponseDto> list = materialService.getMaterialList(1, "테스트");
        assertThat(list).isNotEmpty();
        assertThat(list.get(0).getTitle()).contains("테스트");
        int materialId = list.get(0).getMaterialid();

        // [3] 상세 조회 테스트 (FindById)
        Material findItem = materialRepository.findById(materialId);
        assertThat(findItem).isNotNull();
        assertThat(findItem.getTitle()).isEqualTo("테스트용 양파");

        // [4] 수정 테스트 (Update)
        Material updateEntity = Material.builder()
                .materialid(materialId)
                .title("수정된 양파")
                .category("채소")
                .temperature("냉장")
                .build();
        
        int updateResult = materialRepository.update(updateEntity);
        assertThat(updateResult).isEqualTo(1);
        
        Material updatedItem = materialRepository.findById(materialId);
        assertThat(updatedItem.getTitle()).isEqualTo("수정된 양파");

        // [5] 삭제 테스트 (Delete)
        int deleteResult = materialRepository.deleteById(materialId);
        assertThat(deleteResult).isEqualTo(1);
        
        Material deletedItem = materialRepository.findById(materialId);
        assertThat(deletedItem).isNull();
    }
}