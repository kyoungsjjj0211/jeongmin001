package com.thejoa703.controller;

import com.thejoa703.dto.request.MaterialSaveRequestDto;
import com.thejoa703.dto.response.MaterialResponseDto;
import com.thejoa703.service.MaterialService;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.util.List;

@Controller
@RequestMapping("/material")
@RequiredArgsConstructor // 서비스 주입을 위해 필요
public class MaterialController {

    private final MaterialService materialService;

    @GetMapping("/list")
    public String list(@RequestParam(value = "page", defaultValue = "1") int page,
                       @RequestParam(value = "keyword", defaultValue = "") String keyword,
                       Model model) {
        
        // 리턴 타입이 MaterialResponseDto 리스트로 바뀜
        List<MaterialResponseDto> list = materialService.getMaterialList(page, keyword);
        model.addAttribute("list", list);
        return "material/list";
    }

    @PostMapping("/insert")
    public String insert(MaterialSaveRequestDto requestDto, // MaterialDto 대신 이거 사용!
                         @RequestParam("file") MultipartFile file) {
        
        materialService.saveMaterial(requestDto, file);
        return "redirect:/material/list";
    }
}