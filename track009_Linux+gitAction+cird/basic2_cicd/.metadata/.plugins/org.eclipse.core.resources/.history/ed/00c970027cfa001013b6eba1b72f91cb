<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.thejoa703.dao.MaterialDao">

    <insert id="insertMaterial" parameterType="com.thejoa703.dto.MaterialDto">
        INSERT INTO material (title, imageurl)
        VALUES (#{title}, #{imageurl})
    </insert>

    <update id="updateMaterial" parameterType="com.thejoa703.dto.MaterialDto">
        UPDATE material 
        SET title = #{title}, imageurl = #{imageurl}
        WHERE materialid = #{materialid}
    </update>

    <delete id="deleteMaterial">
        DELETE FROM material WHERE materialid = #{materialid}
    </delete>

    <select id="MaterialList" resultType="com.thejoa703.dto.MaterialDto">
        SELECT * FROM material ORDER BY materialid DESC
    </select>

    <select id="selectMaterial" resultType="com.thejoa703.dto.MaterialDto">
        SELECT * FROM material WHERE materialid = #{materialid}
    </select>

    <select id="selectTitle" resultType="com.thejoa703.dto.MaterialDto">
        SELECT * FROM material WHERE title = #{title}
    </select>

    <select id="select10" parameterType="map" resultType="com.thejoa703.dto.MaterialDto">
        SELECT * FROM (
            SELECT ROWNUM AS rnum, m.* FROM (
                SELECT * FROM material 
                WHERE title LIKE '%' || #{keyword} || '%'
                ORDER BY materialid DESC
            ) m
        ) WHERE rnum BETWEEN #{start} AND #{end}
    </select>

    <select id="selectTotalCnt" parameterType="string" resultType="int">
        SELECT COUNT(*) FROM material WHERE title LIKE '%' || #{keyword} || '%'
    </select>

    <insert id="insertTrend" parameterType="map">
        INSERT INTO material_trend (material_id, keyword, period_data)
        VALUES (#{materialId}, #{keyword}, #{periodData})
    </insert>

</mapper>